---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslations, localeNames, localeTags, locales, toLocale } from '../i18n';

const current = toLocale(Astro.currentLocale);
const t = getTranslations(current).nav;
---

<nav aria-label={t.language} class="flex items-center gap-2">
  {
    locales.map((locale, index) => (
      <>
        {index > 0 && <span aria-hidden="true">/</span>}
        <a
          href={getRelativeLocaleUrl(locale)}
          hreflang={localeTags[locale].lang}
          data-locale-link
          lang={localeTags[locale].lang}
          aria-current={locale === current ? 'page' : undefined}
          class:list={[
            'transition-colors hover:text-gold-300',
            locale === current ? 'text-gold-300' : 'text-cream-200',
          ]}
        >
          {localeNames[locale]}
        </a>
      </>
    ))
  }
</nav>

<script>
  // Switching language keeps the reader where they were instead of jumping to the top.
  const KEY = 'tinas:locale-scroll';
  try {
    const saved = sessionStorage.getItem(KEY);
    if (saved !== null) {
      sessionStorage.removeItem(KEY);
      window.scrollTo({ top: Number(saved), behavior: 'instant' });
    }
    document.querySelectorAll('[data-locale-link]').forEach((link) =>
      link.addEventListener('click', () => sessionStorage.setItem(KEY, String(window.scrollY))),
    );
  } catch {
    // Storage unavailable (private mode, blocked cookies): fall back to a normal navigation.
  }
</script>
