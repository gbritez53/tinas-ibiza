---
import ServiceCard from './ServiceCard.astro';
import { services } from './services';
import { getTranslations } from '../../shared/i18n';

const t = getTranslations(Astro.currentLocale).services;
---

<section id="services" class="scroll-mt-4 bg-cream-200 py-30 text-green-900">
  <div class="mx-auto flex max-w-7xl flex-col gap-14 px-8">
    <div class="flex flex-col items-center gap-4.5 text-center">
      <span data-reveal="line" class="h-14 w-px bg-gold-600" aria-hidden="true"></span>
      <h2
        data-reveal
        class="font-display text-[clamp(44px,5vw,68px)] font-normal tracking-[0.12em] uppercase [--reveal-delay:150ms]"
      >
        {t.title}
      </h2>
      <p data-reveal class="max-w-lg leading-[1.7] text-ink-soft [--reveal-delay:300ms]">
        {t.intro}
      </p>
    </div>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, index) => (
          <li data-reveal style={`--reveal-delay: ${(index % 3) * 120}ms`}>
            <ServiceCard service={service} title={t.items[service.id]} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
