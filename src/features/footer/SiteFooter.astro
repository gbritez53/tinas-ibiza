---
import { Image } from 'astro:assets';
import monogramGold from '../../assets/brand/monogram-gold.png';
import Icon from '../../shared/ui/Icon.astro';
import { site } from '../../shared/config/site';
import { getTranslations } from '../../shared/i18n';

const t = getTranslations(Astro.currentLocale).footer;
const year = new Date().getFullYear();
---

<footer id="contact" class="scroll-mt-4 bg-green-900 px-8 pt-24 pb-10 text-cream-100">
  <div class="mx-auto flex max-w-7xl flex-col gap-16">
    <div class="flex flex-wrap justify-between gap-12">
      <div class="flex flex-[1_1_360px] flex-col gap-5">
        <Image src={monogramGold} alt="TINAS" class="h-16 w-auto self-start" />
        <h2 class="font-editorial text-5xl leading-[1.05]">
          {t.titleStart} <em class="text-gold-300">{t.titleAccent}</em>
        </h2>
      </div>

      <address class="flex flex-[1_1_320px] flex-col gap-4.5 text-base not-italic">
        <p class="flex items-center gap-3.5">
          <Icon name="phone" class="size-5 shrink-0 text-gold-300" />
          <span>
            {
              site.phones.map((phone, index) => (
                <>
                  {index > 0 && ' · '}
                  <a href={phone.href} class="hover:text-gold-300">
                    {phone.label}
                  </a>
                </>
              ))
            }
          </span>
        </p>
        <a href={`mailto:${site.email}`} class="flex items-center gap-3.5 hover:text-gold-300">
          <Icon name="mail" class="size-5 shrink-0 text-gold-300" />
          {site.email}
        </a>
        <a
          href={site.instagram.url}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-3.5 hover:text-gold-300"
        >
          <Icon name="instagram" class="size-5 shrink-0 text-gold-300" />
          {site.instagram.handle}
        </a>
        <p class="flex items-center gap-3.5">
          <Icon name="pin" class="size-5 shrink-0 text-gold-300" />
          {t.location} · {t.languages}
        </p>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="mt-2 self-start rounded-full bg-gold-300 px-7.5 py-4.5 text-[13px] font-semibold tracking-[0.14em] text-green-900 uppercase transition-opacity hover:opacity-90"
        >
          {t.whatsapp}
        </a>
      </address>
    </div>

    <div
      class="flex flex-wrap justify-between gap-3 border-t border-line-dark pt-6 text-[13px] text-mist-muted"
    >
      <span>© {year} {site.name} · Ibiza</span>
      <span>{t.tagline}</span>
    </div>
  </div>
</footer>
