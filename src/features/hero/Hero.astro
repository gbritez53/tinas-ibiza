---
import { Image } from 'astro:assets';
import ibizaEntrance from '../../assets/hero/ibiza-entrance.jpg';
import monogramCream from '../../assets/brand/monogram-cream.png';
import { getTranslations } from '../../shared/i18n';

const t = getTranslations(Astro.currentLocale);
---

<section class="relative isolate flex min-h-[860px] flex-col overflow-hidden">
  <Image
    src={ibizaEntrance}
    alt=""
    widths={[768, 1080, 1440, 1672]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-[rgb(9_34_34/0.62)]"></div>

  <!-- pt-36 makes room for the fixed header, which no longer takes space in the flow. -->
  <div class="flex flex-1 flex-col items-center justify-center gap-5 px-8 pt-36 pb-24 text-center">
    <Image src={monogramCream} alt="" data-reveal="fade" class="h-[110px] w-auto" />
    <h1
      data-reveal
      class="font-display text-[clamp(72px,10vw,150px)] leading-[0.9] font-normal tracking-[0.14em] [--reveal-delay:150ms]"
    >
      TINAS
    </h1>
    <p data-reveal class="text-sm tracking-[0.34em] uppercase [--reveal-delay:300ms]">
      {t.hero.tagline} · <span class="text-gold-300">Ibiza</span>
    </p>
    <div
      data-reveal="line"
      class="mt-4 h-18 w-px bg-cream-200 [--reveal-delay:450ms]"
      aria-hidden="true"
    >
    </div>
    <p
      data-reveal
      class="max-w-3xl font-display text-[clamp(26px,3vw,38px)] leading-tight font-light italic [--reveal-delay:650ms]"
    >
      {t.hero.lead}
    </p>
  </div>
</section>

