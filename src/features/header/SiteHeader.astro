---
import { Image } from 'astro:assets';
import monogramCream from '../../assets/brand/monogram-cream.png';
import Icon from '../../shared/ui/Icon.astro';
import LanguageSwitcher from '../../shared/ui/LanguageSwitcher.astro';
import { navigation } from '../../shared/config/site';
import { getTranslations } from '../../shared/i18n';

const { nav: t, footer } = getTranslations(Astro.currentLocale);
---

<header
  data-site-header
  class="fixed inset-x-0 top-0 z-50 py-5 text-xs font-medium tracking-[0.22em] uppercase transition-[background-color,box-shadow,padding] duration-300 data-scrolled:bg-green-900/95 data-scrolled:py-3 data-scrolled:shadow-[0_8px_30px_rgb(0_0_0/0.18)] data-scrolled:backdrop-blur-sm md:py-7 md:data-scrolled:py-4"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 md:px-8">
    <!-- Desktop -->
    <nav aria-label={t.label} class="hidden gap-8 md:flex">
      {
        navigation.map((item) => (
          <a href={item.href} class="text-cream-200 transition-colors hover:text-gold-300">
            {t[item.key]}
          </a>
        ))
      }
    </nav>
    <div class="hidden items-center gap-6 md:flex">
      <LanguageSwitcher />
      <a
        href="#contact"
        class="border border-gold-300 px-6 py-3.5 text-cream-200 transition-colors hover:bg-gold-300 hover:text-green-900"
      >
        {t.contact}
      </a>
    </div>

    <!-- Mobile -->
    <a href="#" aria-label={t.home} class="md:hidden">
      <Image src={monogramCream} alt="" class="h-9 w-auto" />
    </a>
    <button
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      aria-label={t.openMenu}
      class="-mr-2 p-2 text-cream-200 md:hidden"
    >
      <Icon name="menu" class="size-7" />
    </button>
  </div>
</header>

<dialog
  id="mobile-menu"
  aria-label={t.label}
  class="m-0 h-dvh max-h-none w-full max-w-none translate-y-[-12px] bg-green-900 p-0 text-cream-200 opacity-0 transition-[opacity,translate,display,overlay] transition-discrete duration-300 ease-out backdrop:bg-transparent open:translate-y-0 open:opacity-100 starting:open:translate-y-[-12px] starting:open:opacity-0 md:hidden"
>
  <div class="flex h-full flex-col px-6 py-5">
    <div class="flex items-center justify-between">
      <Image src={monogramCream} alt="" class="h-9 w-auto" />
      <button
        type="button"
        data-menu-close
        autofocus
        aria-label={t.closeMenu}
        class="-mr-2 p-2 text-cream-200"
      >
        <Icon name="close" class="size-7" />
      </button>
    </div>

    <nav aria-label={t.label} class="flex flex-1 flex-col items-center justify-center gap-8">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            data-menu-link
            class="font-display text-4xl font-light tracking-[0.12em] uppercase transition-colors hover:text-gold-300"
          >
            {t[item.key]}
          </a>
        ))
      }
      <span class="h-12 w-px bg-gold-300" aria-hidden="true"></span>
      <a
        href="#contact"
        data-menu-link
        class="border border-gold-300 px-8 py-4 text-xs font-medium tracking-[0.22em] uppercase transition-colors hover:bg-gold-300 hover:text-green-900"
      >
        {t.contact}
      </a>
    </nav>

    <div
      class="flex flex-col items-center gap-4 pb-4 text-xs font-medium tracking-[0.22em] uppercase"
    >
      <LanguageSwitcher />
      <p class="text-[11px] tracking-[0.3em] text-mist-muted">{footer.location}</p>
    </div>
  </div>
</dialog>

<script>
  // Transparent over the hero, solid once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 40);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // Mobile menu: a modal <dialog> gives focus trapping, Esc to close and an inert page for free.
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  if (menu) {
    document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu.showModal());
    document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // Close before the anchor jump so the page is scrollable again when it lands.
    menu.querySelectorAll('[data-menu-link]').forEach((link) =>
      link.addEventListener('click', () => menu.close()),
    );
    // Back on desktop width the dialog is hidden, so make sure it is not left open.
    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) menu.close();
    });
  }
</script>
