---
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/marcellus/latin-400.css';
import '@fontsource-variable/montserrat/wght.css';
import '../styles/global.css';
// Fonts painted in the first viewport (hero title, lead and nav). Preloading them starts the
// download alongside the CSS instead of after it, which is what holds back FCP/LCP on mobile.
import cormorantRegular from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cormorantLightItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import montserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { site } from '../shared/config/site';
import { defaultLocale, getTranslations, localeTags, locales, toLocale } from '../shared/i18n';

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const { title, description } = t.meta;

// Crawlers need absolute URLs; `site` in astro.config.mjs provides the production origin.
const origin = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(`/og-${locale}.jpg`, origin).href;
const businessId = new URL('/#business', origin).href;

// One graph so Google links the page, the website and the business it describes.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HomeAndConstructionBusiness',
      '@id': businessId,
      name: site.name,
      alternateName: site.shortName,
      description,
      url: new URL('/', origin).href,
      logo: new URL('/icon-512.png', origin).href,
      image: ogImage,
      email: site.email,
      telephone: site.phones[0].href.replace('tel:', ''),
      contactPoint: site.phones.map((phone) => ({
        '@type': 'ContactPoint',
        telephone: phone.href.replace('tel:', ''),
        contactType: 'customer service',
        availableLanguage: ['Spanish', 'English'],
      })),
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ibiza',
        postalCode: site.postalCode,
        addressRegion: 'Illes Balears',
        addressCountry: 'ES',
      },
      areaServed: { '@type': 'AdministrativeArea', name: 'Ibiza' },
      founder: site.founders.map((name) => ({ '@type': 'Person', name })),
      foundingDate: site.foundingYear,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.title,
        itemListElement: Object.values(t.services.items).map((name) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: name.replace(/\n/g, ' '),
            areaServed: 'Ibiza',
          },
        })),
      },
      sameAs: [site.instagram.url, site.facebook],
    },
    {
      '@type': 'WebSite',
      name: site.name,
      url: new URL('/', origin).href,
      inLanguage: localeTags[locale].lang,
      publisher: { '@id': businessId },
    },
  ],
};
---

<!doctype html>
<html lang={localeTags[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Runs before first paint so reveal elements never flash visible-then-hidden. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="generator" content={Astro.generator} />
    {
      [cormorantRegular, cormorantLightItalic, montserrat].map((font) => (
        <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
      ))
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e3636" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      locales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={localeTags[alternate].lang}
          href={getAbsoluteLocaleUrl(alternate)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeTags[locale].og} />
    {
      locales
        .filter((alternate) => alternate !== locale)
        .map((alternate) => (
          <meta property="og:locale:alternate" content={localeTags[alternate].og} />
        ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <script>
      // Scroll reveal: see the data-reveal rules in global.css.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        targets.forEach((target) => observer.observe(target));
      } else {
        targets.forEach((target) => target.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
